# =========================================================
# .env.example  —  template for machine/personal settings
# =========================================================
# Copy this file to `.env` and fill in your own values:
#
#   cp "$ZDOTDIR/.env.example" "$ZDOTDIR/.env"
#
# `.env` is gitignored, so your paths, hostnames and keys never get
# committed. This file IS committed and must contain placeholders only.
#
# It is sourced by .zshenv as a zsh script, so:
#   - use `export KEY="value"` lines
#   - `$HOME` and other expansions work
#   - every consumer has a fallback, so an absent .env is not an error

# ---------- Extra PATH entries ----------
# Directory for the `opencode` CLI. Leave unset if you don't use it.
export OPENCODE_BIN="$HOME/.opencode/bin"

# ---------- Bare-repo dotfiles ----------
# Used by the `dotfiles` alias in aliases.zsh.
export DOTFILES_GIT_DIR="$HOME/.dotfiles"
export DOTFILES_WORK_TREE="$HOME"

# ---------- Work: Cloudflare D1 (wrangler) ----------
# Database name used by the dbl / dbTables / dbSchema helpers.
export WRANGLER_D1_DATABASE="MY_DB_STAGING"

# ---------- Remote host shortcut ----------
# Used by the `edcore` function in aliases.zsh.
# Point at your own private key and user@host.
export EDCORE_SSH_KEY="$HOME/.ssh/example/id_ed25519"
export EDCORE_SSH_HOST="user@ssh.example.com"

# ---------- Webcam / capture device ----------
# Used by the `stream` alias. Find yours with: v4l2-ctl --list-devices
export STREAM_DEVICE="/dev/video0"
